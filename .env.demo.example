# The public test-mode demo (compose.demo.yml, docs/DEPLOY.md). Copy to .env.demo ON THE SERVER and fill it in there.
# .env.demo is ignored by git: never commit it, and never copy your laptop's .env to the server.
# Avoid `$` in every value (Docker Compose would treat it as a variable).

# ── The demo ────────────────────────────────────────────────────────────────
# Your domain or subdomain; its DNS A record must point at the server before the first start (Caddy gets the certificate).
DEMO_DOMAIN=kobofx.example.com
# A sandbox: production mode refuses test keys, simulated withdrawals and the demo credit, by design.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# One hop: the UI proxy (or Caddy, for webhooks and docs) sits in front of the API.
TRUST_PROXY_HOPS=1
API_DOCS_ENABLED=true
# Every verified sign-up starts with ₦100,000 of demo money (kobo).
DEMO_CREDIT_NGN_MINOR=10000000

# ── Database (inside the Docker network) ───────────────────────────────────
# Generate each password with: openssl rand -hex 24
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kobofx
DB_APP_USER=fx_app
DB_APP_PASSWORD=
DB_MIGRATION_USER=fx_owner
DB_MIGRATION_PASSWORD=
POSTGRES_SUPERUSER_PASSWORD=
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000

REDIS_URL=redis://redis:6379

ROUNDING_USER_CREDIT=ROUND_DOWN
ROUNDING_USER_DEBIT=ROUND_UP
ROUNDING_REVENUE=ROUND_HALF_EVEN
ROUNDING_FEE=ROUND_HALF_EVEN
LEDGER_INTERNAL_BUCKETS=64

# ── Email: a real SMTP provider (reviewers read their codes in their own inbox) ──
# Brevo's free tier: smtp-relay.brevo.com, port 587, SMTP_SECURE=false (STARTTLS), its SMTP login and key.
# MAIL_FROM must be a sender address you verified with the provider.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=KoboFX Demo <you@example.com>

OUTBOX_MAX_ATTEMPTS=10
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20

# ── Simulated card PSP (the mock-psp service) ───────────────────────────────
PSP_BASE_URL=http://mock-psp:4010
PSP_FUNDING_CURRENCIES=NGN
FUNDING_LIMITS={"NGN":{"minimum":"10000","maximum":"100000000"}}

# ── Paystack: funding through real Paystack test mode, withdrawals through the mock ──
PAYSTACK_ENABLED=true
# Your TEST secret key (sk_test_…), from the Paystack dashboard. Never a live key.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_TRANSFERS_BASE_URL=http://mock-paystack:4030
# Use your domain: the browser's return page after checkout.
PAYSTACK_CALLBACK_URL=https://kobofx.example.com/funding/return
PAYSTACK_FUNDING_CURRENCIES=NGN
# Paystack's published webhook IPs + the mock-paystack service's fixed address in compose.demo.yml.
PAYSTACK_WEBHOOK_IP_ALLOWLIST=52.31.139.75,52.49.173.169,52.214.14.220,10.231.47.30
PAYSTACK_WITHDRAWALS_ENABLED=true
PAYSTACK_ACCOUNT_IDENTITY=paystack-test-account
PAYSTACK_WITHDRAWAL_LIMITS={"NGN":{"minimum":"10000","maximum":"100000000","dailyMaximum":"500000000"}}

CONVERSION_LIMITS={"NGN":{"maximum":"1000000000","dailyMaximum":"5000000000"},"USD":{"maximum":"1000000","dailyMaximum":"5000000"},"EUR":{"maximum":"1000000","dailyMaximum":"5000000"},"GBP":{"maximum":"1000000","dailyMaximum":"5000000"}}

# ── FX rates: the free, key-less open endpoint (daily rates — fine for a sandbox) ──
FX_RATE_BASE_URL=https://open.er-api.com/v6/latest
FX_PROVIDER_PLAN=OPEN

# ── Generated secrets ──────────────────────────────────────────────────────
# Append them below ON THE SERVER (docs/DEPLOY.md, step 5):
#   docker build --target build -t kobofx:tools . && docker run --rm kobofx:tools npm run --silent secrets:generate >> .env.demo
# That adds JWT_*, ONE_TIME_PASSWORD_PEPPER, TRANSACTION_PIN_PEPPER, PSP_SECRET_KEY, PSP_WEBHOOK_SECRETS and the
# withdrawal / idempotency key rings.
