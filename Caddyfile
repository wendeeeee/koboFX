# HTTPS for the demo (compose.demo.yml). Caddy gets and renews the certificate for DEMO_DOMAIN by itself.
# It sets X-Forwarded-For to the real client address (it trusts no incoming forwarding headers), which the UI proxy
# passes on and the API reads through TRUST_PROXY_HOPS=1.
{$DEMO_DOMAIN} {
	encode gzip

	# Machine-to-machine and documentation routes go straight to the API.
	handle /api/v1/webhooks/* {
		reverse_proxy api:3000
	}
	handle /api/v1/docs* {
		reverse_proxy api:3000
	}

	# Everything else is the customer UI; its proxy forwards only the customer API (never /admin).
	handle {
		reverse_proxy ui:5173
	}
}
