{
  "name": "kobofx",
  "version": "0.1.0",
  "private": true,
  "description": "FX Trading App backend",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/stamp-build.js",
    "admin:bootstrap": "ts-node scripts/bootstrap-administrators.ts",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "ts-node src/worker.ts",
    "secrets:generate": "ts-node scripts/generate-authentication-secrets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "test": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:all": "jest --runInBand",
    "test:cov": "jest --maxWorkers=1 --workerIdleMemoryLimit=1024MB --coverage",
    "start:mock-psp:dev": "ts-node src/mock-psp/main.ts",
    "start:mock-fx:dev": "ts-node src/mock-exchange-rate-api/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.4",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.9",
    "lossless-json": "^4.3.1",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^10.0.11",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@nestjs/testing": "^11.2.6",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "supertest": "^7.3.0",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.6"
  }
}
