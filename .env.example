NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_NAME=kobofx
# Runtime role: DML only. Cannot alter schema; cannot UPDATE/DELETE the ledger (Phase 2).
DB_APP_USER=fx_app
DB_APP_PASSWORD=fx_app_dev_password
# Migration role: owns the schema.
DB_MIGRATION_USER=fx_owner
DB_MIGRATION_PASSWORD=fx_owner_dev_password
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000

REDIS_URL=redis://localhost:6379

# Rounding is a business decision (design §4.4) — configuration, not constants.
ROUNDING_USER_CREDIT=ROUND_DOWN
# Debit for an exact target amount ("buy $50 with NGN"): never less than delivered.
ROUNDING_USER_DEBIT=ROUND_UP
ROUNDING_REVENUE=ROUND_HALF_EVEN
ROUNDING_FEE=ROUND_HALF_EVEN

# Used only by docker compose to bootstrap Postgres.
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_password

# Ledger (design §6.6): rows per internal account per currency
LEDGER_INTERNAL_BUCKETS=64

# ── Authentication (design §9.1) ─────────────────────────────────────────────
# No defaults: the process refuses to boot without these. Generate dev values with
#   npm run --silent secrets:generate >> .env
# PEMs are base64-encoded. JWT_PUBLIC_KEYS is base64 JSON {keyId: publicKeyPem};
# keep the previous key in it during a rotation, for one access-token lifetime.
JWT_SIGNING_KEY_ID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
ONE_TIME_PASSWORD_PEPPER=
# JWT_ISSUER=kobofx
# JWT_AUDIENCE=kobofx-api
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800

# Non-production demo credit at verification, in NGN minor units (kobo). 0 = off.
# Refused at boot in production (design §15 item 6).
DEMO_CREDIT_NGN_MINOR=10000000

# ── Email (MailHog in dev: UI at http://localhost:8025) ──────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=KoboFX <no-reply@kobofx.local>

# ── Worker: outbox dispatcher (design §7.6) ──────────────────────────────────
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20

# Reverse proxies in front of the API (for the rate limiter's client IP).
TRUST_PROXY_HOPS=0

# OpenAPI document + Swagger UI at /api/v1/docs and /api/v1/docs-json (Phase 11).
# Default: on outside production, off in production unless set to true.
# API_DOCS_ENABLED=true

# ── Payment service provider (design §7.2, §7.3) ──────────────────────────────
# Dev runs the simulated PSP: `npm run start:mock-psp:dev` (port 4010). Secrets have no
# defaults; `npm run --silent secrets:generate >> .env` prints dev values.
PSP_BASE_URL=http://localhost:4010
PSP_SECRET_KEY=
# Comma-separated base64 HMAC keys (≥ 32 bytes): current first, previous during a rotation.
PSP_WEBHOOK_SECRETS=
# PSP_NAME=simulated-psp
# PSP_WEBHOOK_TOLERANCE_SECONDS=300
# PSP_REQUEST_TIMEOUT_MILLISECONDS=2000
# PSP_READ_RETRIES=3

# Funding: currencies a user may fund, and per-currency bounds in minor units (strings).
PSP_FUNDING_CURRENCIES=NGN
FUNDING_LIMITS={"NGN":{"minimum":"10000","maximum":"100000000"}}

# ── Paystack: a second funding provider, test mode (PAYSTACK_PLAN.md) ────────
# Off by default. One account, one key. A live key (sk_live_) is refused outside production and a
# test key (sk_test_) in production. Never commit a real key. The WEBHOOK URL is set in the Paystack
# dashboard (Settings → API Keys & Webhooks), not here: point it at your tunnel, e.g.
# https://<your-ngrok-host>/api/v1/webhooks/paystack (docs/TESTING.md).
# PAYSTACK_ENABLED=false
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Where the customer's BROWSER returns after paying (a client page; carries no authority — the
# client polls GET /wallet/fund/{fundingId}). Formerly PAYSTACK_WEBHOOK_URL (now refused).
# PAYSTACK_CALLBACK_URL=http://localhost:5173/funding/return
# PAYSTACK_BASE_URL=https://api.paystack.co       # dev against the mock: http://localhost:4030
# PAYSTACK_FUNDING_CURRENCIES=NGN                 # each needs FUNDING_LIMITS (shared with the PSP)
# PAYSTACK_CHECKOUT_WINDOW_MINUTES=30
# Fail-closed when set; Paystack's published webhook IPs (test and live):
# PAYSTACK_WEBHOOK_IP_ALLOWLIST=52.31.139.75,52.49.173.169,52.214.14.220
# PAYSTACK_REQUEST_TIMEOUT_MILLISECONDS=5000
# PAYSTACK_INITIALIZE_TIMEOUT_MILLISECONDS=10000
# PAYSTACK_READ_RETRIES=3

# Protected envelopes for withdrawals (WITHDRAWAL_PLAN.md §H). JSON {keyId: base64}; generate with
# `npm run --silent secrets:generate`. Placeholders only — never commit real key material.
# WITHDRAWAL_KEY_ENCRYPTION_KEYS={"dev-kek-1":"<base64 of 32 random bytes>"}
# WITHDRAWAL_KEY_ENCRYPTION_ACTIVE_KEY_ID=dev-kek-1
# WITHDRAWAL_FINGERPRINT_KEYS={"dev-fingerprint-1":"<base64 of >= 32 random bytes>"}
# WITHDRAWAL_FINGERPRINT_ACTIVE_KEY_ID=dev-fingerprint-1
# IDEMPOTENCY_REQUEST_HASH_KEYS={"dev-request-hash-1":"<base64 of >= 32 random bytes>"}
# IDEMPOTENCY_REQUEST_HASH_ACTIVE_KEY_ID=dev-request-hash-1
# Mock Paystack (dev only, `npm run start:mock-paystack:dev`): its port and where it sends webhooks.
# MOCK_PAYSTACK_PORT=4030
# MOCK_PAYSTACK_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/paystack

# Conversions (design §7.7, Phase 7): per SOURCE currency, the largest single conversion and the most
# one user may convert from it in any rolling 24 hours, in minor units (strings). Every currency a
# user can sell needs an entry (boot refuses otherwise).
CONVERSION_LIMITS={"NGN":{"maximum":"1000000000","dailyMaximum":"5000000000"},"USD":{"maximum":"1000000","dailyMaximum":"5000000"},"EUR":{"maximum":"1000000","dailyMaximum":"5000000"},"GBP":{"maximum":"1000000","dailyMaximum":"5000000"}}

# ── Worker: flows, webhooks, reservation sweeper (design §7.5) ───────────────
# FLOW_POLL_INTERVAL_MILLISECONDS=1000
# FLOW_BATCH_SIZE=20
# FLOW_LEASE_SECONDS=60
# FLOW_MAXIMUM_BACKOFF_SECONDS=900
# FLOW_STALLED_AFTER_MINUTES=30
# WEBHOOK_MAX_ATTEMPTS=10
# RESERVATION_SWEEP_INTERVAL_MILLISECONDS=30000

# Simulated PSP (dev only): where it sends webhooks, and how long a capture takes.
# MOCK_PSP_PORT=4010
# MOCK_PSP_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/psp
# MOCK_PSP_CAPTURE_DELAY_MS=2000

# ── FX rates (design §7.2, §7.4; Phase 6) ─────────────────────────────────────
# One provider, ExchangeRate-API. The open-access endpoint needs no key (updates once a
# day, 429 → 20-minute IP lockout, attribution required — GET /fx/rates carries it):
FX_RATE_BASE_URL=https://open.er-api.com/v6/latest
FX_PROVIDER_PLAN=OPEN
# A keyed plan instead puts the key IN THE PATH via the {apiKey} placeholder (the key is
# never recorded or logged). Production refuses OPEN and FREE (daily rates are too old
# to trade on); BUSINESS (5-minute updates) is the production plan:
#   FX_RATE_BASE_URL=https://v6.exchangerate-api.com/v6/{apiKey}/latest
#   FX_PROVIDER_PLAN=BUSINESS
#   EXCHANGE_RATE_API_KEY=
# Local development against the simulated provider instead (npm run start:mock-fx:dev):
#   FX_RATE_BASE_URL=http://localhost:4020/v6/latest
# Plan-derived defaults, overridable: request budgets (per UTC month/day, every attempt
# counted across all instances) and the freshness windows (from the provider's own
# publication time).
# FX_MONTHLY_REQUEST_BUDGET=
# FX_DAILY_REQUEST_BUDGET=
# FX_EXECUTABLE_MAXIMUM_RATE_AGE_SECONDS=
# FX_DISPLAY_MAXIMUM_RATE_AGE_SECONDS=
# FX_PUBLICATION_GRACE_SECONDS=
# Sanity: reject a fetch where any active currency moved more than this from the last
# accepted value (never auto-accepted; Phase 10's four-eyes override accepts a real move).
# FX_MAXIMUM_JUMP_RATIO=0.20
# FX_JUMP_RATIO_OVERRIDES={}
# FX_RATE_BOUNDS={"USD":{"minimum":"1","maximum":"1"},"NGN":{"minimum":"100","maximum":"100000"},"EUR":{"minimum":"0.1","maximum":"10"},"GBP":{"minimum":"0.1","maximum":"10"}}
# FX_QUOTE_TIME_TO_LIVE_SECONDS=30
# FX_REQUEST_TIMEOUT_MILLISECONDS=2000
# FX_READ_RETRIES=3
# FX_POLL_INTERVAL_MILLISECONDS=15000
