# Copy to .env for local development. Every optional setting not listed here has a default
# in src/config/configuration.ts.

# ── App ──
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Reverse proxies in front of the API (for the rate limiter's client IP).
TRUST_PROXY_HOPS=0

# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kobofx
DB_APP_USER=fx_app
DB_APP_PASSWORD=fx_app_dev_password
DB_MIGRATION_USER=fx_owner
DB_MIGRATION_PASSWORD=fx_owner_dev_password
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000
# Used only by docker compose to bootstrap Postgres.
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_password

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Ledger ──
ROUNDING_USER_CREDIT=ROUND_DOWN
ROUNDING_USER_DEBIT=ROUND_UP
ROUNDING_REVENUE=ROUND_HALF_EVEN
ROUNDING_FEE=ROUND_HALF_EVEN
LEDGER_INTERNAL_BUCKETS=64

# ── Secrets (required) ──
# Fill these with: npm run --silent secrets:generate >> .env
JWT_SIGNING_KEY_ID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
ONE_TIME_PASSWORD_PEPPER=
TRANSACTION_PIN_PEPPER=
PSP_SECRET_KEY=
PSP_WEBHOOK_SECRETS=

# Demo money credited at sign-up verification, in kobo (0 = off; non-production only).
DEMO_CREDIT_NGN_MINOR=10000000

# ── Email ──
# mailhog (local, read at http://localhost:8025) | smtp | brevo
MAIL_TRANSPORT=mailhog
MAILHOG_HOST=localhost
MAILHOG_SMTP_PORT=1025
MAIL_FROM=KoboFX <no-reply@kobofx.local>
# brevo:
# BREVO_API_KEY=
# smtp:
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ── Worker ──
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20

# ── Funding and conversion ──
# Simulated PSP: npm run start:mock-psp:dev
PSP_BASE_URL=http://localhost:4010
PSP_FUNDING_CURRENCIES=NGN
FUNDING_LIMITS={"NGN":{"minimum":"10000","maximum":"100000000"}}
CONVERSION_LIMITS={"NGN":{"maximum":"1000000000","dailyMaximum":"5000000000"},"USD":{"maximum":"1000000","dailyMaximum":"5000000"},"EUR":{"maximum":"1000000","dailyMaximum":"5000000"},"GBP":{"maximum":"1000000","dailyMaximum":"5000000"}}

# ── Paystack (optional) ──
# PAYSTACK_ENABLED=true
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_CALLBACK_URL=http://localhost:5173/funding/return
# Simulated Paystack for withdrawals: npm run start:mock-paystack:dev
# PAYSTACK_TRANSFERS_BASE_URL=http://localhost:4030
# Withdrawal keys (values from secrets:generate):
# WITHDRAWAL_KEY_ENCRYPTION_KEYS=
# WITHDRAWAL_KEY_ENCRYPTION_ACTIVE_KEY_ID=dev-kek-1
# WITHDRAWAL_FINGERPRINT_KEYS=
# WITHDRAWAL_FINGERPRINT_ACTIVE_KEY_ID=dev-fingerprint-1
# IDEMPOTENCY_REQUEST_HASH_KEYS=
# IDEMPOTENCY_REQUEST_HASH_ACTIVE_KEY_ID=dev-request-hash-1

# ── FX rates ──
FX_RATE_BASE_URL=https://open.er-api.com/v6/latest
FX_PROVIDER_PLAN=OPEN
# Simulated provider instead: npm run start:mock-fx:dev, then
# FX_RATE_BASE_URL=http://localhost:4020/v6/latest
