NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_NAME=kobofx
# Runtime role: DML only. Cannot alter schema; cannot UPDATE/DELETE the ledger (Phase 2).
DB_APP_USER=fx_app
DB_APP_PASSWORD=fx_app_dev_password
# Migration role: owns the schema.
DB_MIGRATION_USER=fx_owner
DB_MIGRATION_PASSWORD=fx_owner_dev_password
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000

REDIS_URL=redis://localhost:6379

# Rounding is a business decision (design §4.4) — configuration, not constants.
ROUNDING_USER_CREDIT=ROUND_DOWN
# Debit for an exact target amount ("buy $50 with NGN"): never less than delivered.
ROUNDING_USER_DEBIT=ROUND_UP
ROUNDING_REVENUE=ROUND_HALF_EVEN
ROUNDING_FEE=ROUND_HALF_EVEN

# Used only by docker compose to bootstrap Postgres.
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_password

# Ledger (design §6.6): rows per internal account per currency
LEDGER_INTERNAL_BUCKETS=64

# ── Authentication (design §9.1) ─────────────────────────────────────────────
# No defaults: the process refuses to boot without these. Generate dev values with
#   npm run --silent secrets:generate >> .env
# PEMs are base64-encoded. JWT_PUBLIC_KEYS is base64 JSON {keyId: publicKeyPem};
# keep the previous key in it during a rotation, for one access-token lifetime.
JWT_SIGNING_KEY_ID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
ONE_TIME_PASSWORD_PEPPER=
# JWT_ISSUER=kobofx
# JWT_AUDIENCE=kobofx-api
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800

# Non-production demo credit at verification, in NGN minor units (kobo). 0 = off.
# Refused at boot in production (design §15 item 6).
DEMO_CREDIT_NGN_MINOR=10000000

# ── Email (MailHog in dev: UI at http://localhost:8025) ──────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=KoboFX <no-reply@kobofx.local>

# ── Worker: outbox dispatcher (design §7.6) ──────────────────────────────────
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20

# Reverse proxies in front of the API (for the rate limiter's client IP).
TRUST_PROXY_HOPS=0

# ── Payment service provider (design §7.2, §7.3) ──────────────────────────────
# Dev runs the simulated PSP: `npm run start:mock-psp:dev` (port 4010). Secrets have no
# defaults; `npm run --silent secrets:generate >> .env` prints dev values.
PSP_BASE_URL=http://localhost:4010
PSP_SECRET_KEY=
# Comma-separated base64 HMAC keys (≥ 32 bytes): current first, previous during a rotation.
PSP_WEBHOOK_SECRETS=
# PSP_NAME=simulated-psp
# PSP_WEBHOOK_TOLERANCE_SECONDS=300
# PSP_REQUEST_TIMEOUT_MILLISECONDS=2000
# PSP_READ_RETRIES=3

# Funding: currencies a user may fund, and per-currency bounds in minor units (strings).
PSP_FUNDING_CURRENCIES=NGN
FUNDING_LIMITS={"NGN":{"minimum":"10000","maximum":"100000000"}}

# ── Worker: flows, webhooks, reservation sweeper (design §7.5) ───────────────
# FLOW_POLL_INTERVAL_MILLISECONDS=1000
# FLOW_BATCH_SIZE=20
# FLOW_LEASE_SECONDS=60
# FLOW_MAXIMUM_BACKOFF_SECONDS=900
# FLOW_STALLED_AFTER_MINUTES=30
# WEBHOOK_MAX_ATTEMPTS=10
# RESERVATION_SWEEP_INTERVAL_MILLISECONDS=30000

# Simulated PSP (dev only): where it sends webhooks, and how long a capture takes.
# MOCK_PSP_PORT=4010
# MOCK_PSP_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/psp
# MOCK_PSP_CAPTURE_DELAY_MS=2000
